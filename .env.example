# =============================================================================
# Contoh konfigurasi environment. SALIN menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env asli — file ini hanya berisi contoh.
# =============================================================================

# --- Database (WAJIB) --------------------------------------------------------
# PostgreSQL. Untuk pengembangan lokal tanpa server Postgres, jalankan
# `npm run db:dev` — skrip itu menyalakan PostgreSQL lokal (embedded-postgres)
# pada port 55432 dengan kredensial postgres/postgres.
#
# Produksi (Vercel/Neon/Supabase/RDS/dll) gunakan connection string dari
# penyedia database:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/dimsum?schema=public"

# --- Sesi admin (WAJIB, minimal 32 karakter acak) ----------------------------
# Dipakai untuk HMAC-SHA256 cookie sesi. Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# GANTI nilai contoh di bawah sebelum deployment publik.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-sebelum-deploy"

# --- Kredensial admin mode demonstrasi ---------------------------------------
# Kredensial awal dibuat oleh `npm run db:seed`.
# WAJIB diganti untuk produksi (password disimpan sebagai hash scrypt, lihat
# src/lib/password.ts).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# --- Identitas aplikasi ------------------------------------------------------
# Origin publik aplikasi. Dipakai untuk canonical URL, metadata, dan
# pencocokan Origin pada proteksi CSRF.
# Contoh: https://dimsumkita.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Pengaturan toko awal (opsional, dipakai sebagai default seed) -----------
# Nilai berikut hanya menjadi nilai awal tabel StoreSettings saat seeding.
# Setelah itu ubah melalui dashboard /admin/settings.
STORE_BRAND_NAME="Dimsum Kita"
STORE_WHATSAPP="6281234567890"
STORE_EMAIL="halo@example.com"
STORE_ADDRESS="Alamat toko belum diisi - atur di dashboard admin"
STORE_INSTAGRAM=""
STORE_TIKTOK=""

# --- Mode keamanan -----------------------------------------------------------
# "1" hanya untuk pengembangan di atas http://localhost (cookie Secure dimatikan).
# JANGAN diisi "1" pada produksi HTTPS.
ALLOW_INSECURE_COOKIES="0"

# Izinkan tombol "Reset Data Demo" berjalan ketika NODE_ENV=production.
# Biarkan kosong pada produksi: default-nya reset ditolak agar data asli aman.
ALLOW_DEMO_RESET=""
